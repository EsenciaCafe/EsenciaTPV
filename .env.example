VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Esencia Menu Manager (Firebase). Los valores públicos actuales se usan como
# fallback; define estos campos para poder cambiar de proyecto sin tocar código.
VITE_MENU_FIREBASE_API_KEY=
VITE_MENU_FIREBASE_AUTH_DOMAIN=
VITE_MENU_FIREBASE_PROJECT_ID=
VITE_MENU_FIREBASE_STORAGE_BUCKET=
VITE_MENU_FIREBASE_MESSAGING_SENDER_ID=
VITE_MENU_FIREBASE_APP_ID=
VITE_MENU_FIREBASE_ADMIN_UID=

VITE_LOYALTY_SUPABASE_URL=
VITE_LOYALTY_SUPABASE_ANON_KEY=

# OAuth web client de Google. Solo se usa para leer la carpeta de resultados
# JSON elegida por el propietario; no es una clave de IA.
VITE_GOOGLE_CLIENT_ID=

# Supabase Edge Function secrets for Square gift cards.
# Set these in Supabase, not in the public Vite app.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://<project-ref>.supabase.co/functions/v1/square-gift-cards

# Bot privado de consultas de ventas por Telegram.
# Son secretos de Supabase; nunca deben llevar el prefijo VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
AUDIT_SUPABASE_URL=
AUDIT_SUPABASE_SECRET_KEY=
