VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_LOYALTY_SUPABASE_URL=
VITE_LOYALTY_SUPABASE_ANON_KEY=

# OAuth web client de Google. Solo se usa para leer la carpeta de resultados
# JSON elegida por el propietario; no es una clave de IA.
VITE_GOOGLE_CLIENT_ID=

# Supabase Edge Function secrets for Square gift cards.
# Set these in Supabase, not in the public Vite app.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://<project-ref>.supabase.co/functions/v1/square-gift-cards
